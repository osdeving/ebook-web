---
interface Props {
  current?: "home" | "search" | "glossary" | "study" | "references";
  contentTarget?: string;
}

const { current, contentTarget = "page-content" } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { id: "search", href: `${base}search/`, label: "Busca global" },
  { id: "glossary", href: `${base}glossary/`, label: "Glossário" },
  { id: "study", href: `${base}study/`, label: "Rotas de estudo" },
  { id: "references", href: `${base}references/`, label: "Referências" },
] as const;
---

<a class="skip-link" href={`#${contentTarget}`}>Pular para o conteúdo</a>
<nav class="site-nav" aria-label="Navegação principal">
  <a class="library-brand" href={base} aria-label="Ebook Web, início" aria-current={current === "home" ? "page" : undefined}>
    <span aria-hidden="true">∑</span>
    <strong>Ebook Web</strong>
  </a>
  <div class="site-nav__links">
    {links.map((link) => (
      <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>
    ))}
  </div>
</nav>
