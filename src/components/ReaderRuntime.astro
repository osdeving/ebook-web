<script>
  import { bootstrapReader } from "../framework";
  import type { ChapterDefinition } from "../framework/types";

  const chapterModules = import.meta.glob<{ default: ChapterDefinition }>(
    "../chapters/*/chapter.ts",
  );
  const shell = document.querySelector<HTMLElement>("[data-reader-shell]");
  const article = document.querySelector<HTMLElement>("[data-reader-content]");
  const discoveryElement = document.querySelector<HTMLScriptElement>("[data-reader-discovery]");
  const slug = shell?.dataset.chapterId;

  if (shell && article && slug) {
    const entry = Object.entries(chapterModules).find(([path]) =>
      path.endsWith(`/chapters/${slug}/chapter.ts`),
    );
    if (!entry) {
      console.error(`[ebook-web] módulo do capítulo ausente: ${slug}`);
    } else {
      entry[1]().then(async ({ default: chapter }) => {
        let discovery;
        try {
          discovery = discoveryElement?.textContent
            ? JSON.parse(discoveryElement.textContent)
            : undefined;
        } catch (error) {
          console.error("[ebook-web] dados de descoberta inválidos", error);
        }
        const chapterCleanup = chapter.initialize?.(article);
        const reader = await bootstrapReader({
          chapterId: chapter.slug,
          sourceHash: chapter.sourceHash,
          enrichments: chapter.enrichments,
          discovery,
        });
        window.addEventListener(
          "pagehide",
          () => {
            chapterCleanup?.();
            reader.destroy();
          },
          { once: true },
        );
      }).catch((error) => {
        console.error(`[ebook-web] não foi possível iniciar ${slug}`, error);
      });
    }
  }
</script>
