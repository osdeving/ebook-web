---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página não encontrada" description="A página solicitada não existe no Ebook Web.">
  <main class="not-found">
    <p class="library-kicker">Erro 404</p>
    <h1>Esta página saiu da margem.</h1>
    <p>O endereço pode ter mudado ou o capítulo ainda não foi publicado.</p>
    <a class="enrichment-button enrichment-button--primary" href={import.meta.env.BASE_URL}>Voltar à biblioteca</a>
  </main>
</BaseLayout>
