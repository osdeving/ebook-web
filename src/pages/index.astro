---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChapterLibrary from "../components/react/ChapterLibrary";
import SiteNav from "../components/SiteNav.astro";
import { chapters } from "../chapters";

const base = import.meta.env.BASE_URL;
const summaries = chapters.map((chapter) => ({
  slug: chapter.slug,
  number: chapter.number,
  title: chapter.title,
  description: chapter.description,
  href: `${base}chapters/${chapter.slug}/`,
  sections: chapter.sourceSections.length,
  counts: {
    explanation: chapter.enrichments.filter(({ layer }) => layer === "explanation").length,
    lab: chapter.enrichments.filter(({ layer }) => layer === "lab").length,
    practice: chapter.enrichments.filter(({ layer }) => layer === "practice").length,
    history: chapter.enrichments.filter(({ layer }) => layer === "history").length,
    reading: chapter.enrichments.filter(({ layer }) => layer === "reading").length,
  },
}));
---

<BaseLayout
  title="Ebook Web"
  description="Capítulos matemáticos em HTML semântico com explicações, laboratórios, práticas, história e leituras opcionais."
>
  <main class="library-page">
    <SiteNav current="home" />
    <header class="library-hero" id="page-content">
      <div class="library-hero__copy">
        <p class="library-kicker">Ebook web dinâmico</p>
        <h1>Explore o conteúdo<br /><em>de forma dinâmica.</em></h1>
        <p>Leia a tradução, navegue entre definições, proposições, exercícios e referências e ative explicações, laboratórios e práticas conforme precisar.</p>
      </div>
      <div class="library-layer-map" aria-label="Camadas do framework">
        <span>Fonte preservada</span><span>Explicação</span><span>Laboratório</span><span>Prática</span><span>História</span><span>Leitura</span>
      </div>
      <a class="library-reference-link" href={`${base}references/`}>Consultar as 150 referências <span aria-hidden="true">→</span></a>
    </header>

    <section class="library-tools" aria-labelledby="library-tools-title">
      <div class="library-tools__heading">
        <div><p class="library-kicker">Ferramentas de estudo</p><h2 id="library-tools-title">Encontre seu próximo passo</h2></div>
      </div>
      <div class="library-tools__grid">
        <article class="library-tool-card"><span>01 · DESCOBRIR</span><h3><a href={`${base}search/`}>Busca global</a></h3><p>Pesquise o texto, resultados, exercícios, soluções, laboratórios e referências.</p></article>
        <article class="library-tool-card"><span>02 · CONSULTAR</span><h3><a href={`${base}glossary/`}>Glossário e símbolos</a></h3><p>Revise conceitos e notação com links diretos para o contexto matemático.</p></article>
        <article class="library-tool-card"><span>03 · PERCORRER</span><h3><a href={`${base}study/`}>Rotas de estudo</a></h3><p>Siga percursos por objetivo, tempo disponível e nível de familiaridade.</p></article>
        <article class="library-tool-card"><span>04 · INVESTIGAR</span><h3><a href={`${base}references/`}>Referências</a></h3><p>Filtre a bibliografia, visite fontes abertas e descubra onde cada obra é citada.</p></article>
      </div>
    </section>

    <ChapterLibrary client:idle chapters={summaries} />

    <section class="library-principles" aria-labelledby="principles-title">
      <p class="library-kicker">Arquitetura editorial</p>
      <h2 id="principles-title">Uma tradução, muitas formas de estudar</h2>
      <div>
        <article><span>01</span><h3>Fonte verificável</h3><p>Seções originais ficam isoladas e protegidas por hash contra alterações silenciosas.</p></article>
        <article><span>02</span><h3>Recursos encaixáveis</h3><p>Cada apoio possui arquivo, tipo e âncora próprios. Ligar ou remover um não reescreve o capítulo.</p></article>
        <article><span>03</span><h3>Interatividade sob medida</h3><p>Astro entrega HTML estático; JavaScript e React carregam somente nas ilhas que precisam deles.</p></article>
      </div>
    </section>
  </main>
</BaseLayout>
