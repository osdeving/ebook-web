---
import BaseLayout from "../layouts/BaseLayout.astro";
import Bibliography from "../components/Bibliography.astro";
import SiteNav from "../components/SiteNav.astro";
import { chapters } from "../chapters";
import references from "../content/references.json";
import { buildDiscoveryData } from "../lib/discovery";

const referenceBacklinks = buildDiscoveryData(chapters, references).referenceBacklinks;
---

<BaseLayout
  title="Referências"
  description="Bibliografia linkável de An Introduction to Mathematical Cryptography, com DOI e páginas originais quando localizados."
>
  <main class="references-page">
    <SiteNav current="references" />
    <Bibliography entries={references} backlinks={referenceBacklinks} />
    <footer class="references-note">
      <p>As entradas bibliográficas preservam os dados e os títulos do livro. URLs explícitas foram mantidas; links adicionais foram conferidos por DOI ou na página da editora/autoria. Busca, filtros e exportações são processados neste dispositivo.</p>
      <a href="#bibliography-title">Voltar ao início</a>
    </footer>
  </main>
</BaseLayout>
