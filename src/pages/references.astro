---
import BaseLayout from "../layouts/BaseLayout.astro";
import Bibliography from "../components/Bibliography.astro";
import references from "../content/references.json";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Referências"
  description="Bibliografia linkável de An Introduction to Mathematical Cryptography, com DOI e páginas originais quando localizados."
>
  <main class="references-page">
    <nav class="references-nav" aria-label="Navegação da bibliografia">
      <a class="library-brand" href={base} aria-label="Ebook Web, início">
        <span aria-hidden="true">∑</span>
        <strong>Ebook Web</strong>
      </a>
      <a href={base}>Voltar aos capítulos</a>
    </nav>
    <Bibliography entries={references} />
    <footer class="references-note">
      <p>As entradas bibliográficas preservam os dados e os títulos do livro. URLs explícitas foram mantidas; links adicionais foram conferidos por DOI ou na página da editora/autoria.</p>
      <a href="#bibliography-title">Voltar ao início</a>
    </footer>
  </main>
</BaseLayout>
